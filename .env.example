# Copy to .env for local development: cp .env.example .env
# .env is ignored by git. Never commit real credentials.

# Database
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=portal

# Public address of the site. The GitHub OAuth app's callback URL must be
# BASE_URL + /auth/github/callback.
BASE_URL=http://localhost:8000

# From the GitHub OAuth app (Settings > Developer settings > OAuth Apps).
# Leave empty to run without sign-in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Signs the session cookie. Generate a real one with: openssl rand -hex 32
SESSION_SECRET=local-development-only-not-a-real-secret-000000
COOKIE_SECURE=false

# Your GitHub login: signs in as admin without an invite.
ADMIN_GITHUB_LOGINS=PragalvaXFREZ

# Shown to people who sign in without an invite, so they can ask to join.
# Defaults to pragalva.sapkota@deerwalk.edu.np. Set it empty to hide the line.
# CONTACT_EMAIL=
